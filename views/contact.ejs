<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Consulting Group - Contact Us</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-white shadow-md">
        <div class="max-w-7xl mx-auto pl-0 pr-4 sm:pr-6 lg:pr-8">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center">
                    <img src="/logo.jpg" alt="Green Consulting Group Logo" class="h-20 w-auto">
                </div>
                <nav class="hidden md:flex space-x-8">
                    <a href="/" class="text-gray-700 hover:text-green-800">Home</a>
                    <a href="/about" class="text-gray-700 hover:text-green-800">About</a>
                    <a href="/services" class="text-gray-700 hover:text-green-800">Services</a>
                    <a href="/expertise" class="text-gray-700 hover:text-green-800">Expertise</a>
                    <a href="/mission" class="text-gray-700 hover:text-green-800">Mission</a>
                    <a href="/contact" class="text-gray-700 hover:text-green-800">Contact</a>
                </nav>
                <div class="md:hidden">
                    <button class="text-gray-700 hover:text-green-800 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Contact Section -->
    <section class="bg-gray-50 py-16">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-bold text-green-800 mb-4">Contact Us</h2>
                <p class="text-lg text-gray-600">Have a project or inquiry? We'd love to hear from you. Reach out to discuss your environmental needs.</p>
            </div>
            <div class="grid md:grid-cols-2 gap-12">
                <div>
                    <h3 class="text-2xl font-semibold text-green-700 mb-4">Get In Touch</h3>
                    <div class="space-y-4">
                        <div class="flex items-center">
                            <svg class="h-6 w-6 text-green-600 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <p class="text-gray-700">123 Environmental Way, Kampala, Uganda</p>
                        </div>
                        <div class="flex items-center">
                            <svg class="h-6 w-6 text-green-600 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            <p class="text-gray-700">+256 772 063 06, +256 777 214 909</p>
                        </div>
                        <div class="flex items-center">
                            <svg class="h-6 w-6 text-green-600 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            <p class="text-gray-700">munyanezagodfrey7@gmail.com</p>
                        </div>
                    </div>
                    <img src="/uploads/resort.jpg" alt="Contact Us" class="w-full mt-6 rounded-lg shadow-lg">
                </div>
                <div>
                    <h3 class="text-2xl font-semibold text-green-700 mb-4">Send Us a Message</h3>
                    <form action="/contact" method="post" class="grid gap-4">
                        <input type="text" name="name" placeholder="Your Name" class="border p-3 rounded-lg w-full" required />
                        <input type="email" name="email" placeholder="Your Email" class="border p-3 rounded-lg w-full" required />
                        <textarea name="message" placeholder="Your Message" rows="6" class="border p-3 rounded-lg w-full" required></textarea>
                        <button type="submit" class="bg-green-700 text-white py-3 rounded-lg hover:bg-green-800 transition duration-300">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-green-800 text-white py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p>&copy; 2025 Green Consulting Group. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>