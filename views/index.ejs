<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upwil Environmental Integrated Consultancy and Research Center Ltd - Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }
        body { 
            padding-top: 60px; 
            padding-bottom: 50px; 
            background-color: #f0fdf4;
            font-family: 'DM Sans', sans-serif;
        }
        header { 
            position: fixed; 
            top: 0; 
            left: 0; 
            right: 0; 
            z-index: 10; 
            background: rgba(22, 101, 52, 0.95); 
            backdrop-filter: blur(10px); 
            box-shadow: 0 2px 4px rgba(22, 101, 52, 0.2); 
            transition: all 0.3s;
            font-family: 'DM Sans', sans-serif;
        }
        footer { 
            position: fixed; 
            bottom: 0; 
            left: 0; 
            right: 0; 
            z-index: 10;
            font-family: 'DM Sans', sans-serif;
        }
        .fade-in { opacity: 0; transform: translateY(20px); transition: all 0.6s ease-out; }
        .fade-in.visible { opacity: 1; transform: translateY(0); }
        .card-hover { transition: transform 0.3s, box-shadow 0.3s; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.15); }
        
        /* Video background styles */
        .video-hero {
            position: relative;
            overflow: hidden;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .video-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }
        .video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(22, 101, 52, 0.4);
            z-index: 2;
        }
        /* Fallback background if video fails to load */
        .video-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #166534 0%, #22c55e 100%);
            z-index: 0;
        }
        .fallback-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            display: none;
        }
        
        /* Apply DM Sans font to all text elements */
        h1, h2, h3, h4, h5, h6, p, a, span, div, button, input, textarea, select {
            font-family: 'DM Sans', sans-serif;
        }
        
        /* Moving cards animation */
        .moving-cards-container {
            overflow: hidden;
            position: relative;
            width: 100%;
        }
        
        .moving-cards-track {
            display: flex;
            gap: 2rem;
            animation: scroll-cards 30s linear infinite;
        }
        
        .moving-card {
            flex: 0 0 auto;
            width: 350px;
            background: white;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }
        
        .moving-card:hover {
            transform: translateY(-5px);
        }
        
        @keyframes scroll-cards {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(-100%);
            }
        }
        
        /* Pause animation on hover */
        .moving-cards-container:hover .moving-cards-track {
            animation-play-state: paused;
        }
        
        /* Icon styles for expertise section */
        .expertise-icon {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #dcfce7;
            border-radius: 50%;
            margin: 0 auto 1.5rem;
            color: #166534;
        }
    </style>
</head>
<body class="bg-green-50 font-sans">
