<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }
        body { 
            padding-top: 0; /* Remove top padding */
            padding-bottom: 50px; 
            background-color: #f0fdf4;
            font-family: 'DM Sans', sans-serif;
        }
        header { 
            position: fixed; 
            top: 0; 
            left: 0; 
            right: 0; 
            z-index: 10; 
            background: rgba(22, 101, 52, 0.95); 
            backdrop-filter: blur(10px); 
            box-shadow: 0 2px 4px rgba(22, 101, 52, 0.2); 
            transition: all 0.3s;
            font-family: 'DM Sans', sans-serif;
            padding: 1rem 0; /* Same padding as footer */
        }
        footer { 
            position: fixed; 
            bottom: 0; 
            left: 0; 
            right: 0; 
            z-index: 10;
            font-family: 'DM Sans', sans-serif;
            background-color: #166534; /* Same as header */
            color: white;
            padding: 1rem 0; /* Same padding as header */
        }
        .fade-in { opacity: 0; transform: translateY(20px); transition: all 0.6s ease-out; }
        .fade-in.visible { opacity: 1; transform: translateY(0); }
        .card-hover { transition: transform 0.3s, box-shadow 0.3s; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.15); }
        
        /* Video background styles */
        .video-hero {
            position: relative;
            overflow: hidden;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 0; /* Ensure no margin at top */
        }
        .video-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }
        .video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(22, 101, 52, 0.4);
            z-index: 2;
        }
        /* Fallback background if video fails to load */
        .video-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #166534 0%, #22c55e 100%);
            z-index: 0;
        }
        .fallback-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            display: none;
        }
        
        /* Apply DM Sans font to all text elements */
        h1, h2, h3, h4, h5, h6, p, a, span, div, button, input, textarea, select {
            font-family: 'DM Sans', sans-serif;
        }
        
        /* Hero text styles */
        .hero-content {
            position: relative;
            z-index: 3;
            text-align: center;
            color: white;
            max-width: 800px;
            padding: 0 20px;
        }
        
        /* Services Carousel Styles */
        .services-carousel-container {
            position: relative;
            overflow: hidden;
            width: 100%;
            padding: 20px 0;
        }
        
        .services-carousel-track {
            display: flex;
            transition: transform 0.5s ease;
            width: max-content;
        }
        
        .services-carousel-slide {
            flex: 0 0 auto;
            width: 400px;
            margin: 0 15px;
            box-sizing: border-box;
        }
        
        /* Expertise Carousel Styles */
        .carousel-container {
            position: relative;
            overflow: hidden;
            width: 100%;
        }
        
        .carousel-track {
            display: flex;
            transition: transform 0.5s ease;
        }
        
        .carousel-slide {
            min-width: 100%;
            box-sizing: border-box;
        }
        
        .carousel-nav {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }
        
        .carousel-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #cbd5e0;
            margin: 0 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        .carousel-dot.active {
            background-color: #166534;
        }
        
        .carousel-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background-color: rgba(22, 101, 52, 0.8);
            color: white;
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 5;
            transition: background-color 0.3s;
        }
        
        .carousel-arrow:hover {
            background-color: rgba(22, 101, 52, 1);
        }
        
        .carousel-arrow.prev {
            left: 10px;
        }
        
        .carousel-arrow.next {
            right: 10px;
        }
        
        /* Icon styles for expertise section */
        .expertise-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #dcfce7;
            border-radius: 50%;
            color: #166534;
        }
        
        .expertise-icon svg {
            width: 40px;
            height: 40px;
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .services-carousel-slide {
                width: 300px;
            }
        }
    </style>
</head>
